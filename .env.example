AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BOARD_MODEL_ID=
# MODEL_PROVIDER=bedrock forces Bedrock for board + notes (default: anthropic if ANTHROPIC_API_KEY is set, else bedrock)
MODEL_PROVIDER=
NOTES_MODEL_ID=us.amazon.nova-micro-v1:0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=
ANTHROPIC_NOTES_MODEL_ID=

# Whisper voice. With ELEVENLABS_API_KEY set, ElevenLabs speaks (more natural) and Polly is the fallback.
# Without it, Polly speaks if AWS is set up; with neither, the page uses the browser's own voice.
ELEVENLABS_API_KEY=
# Optional: a voice id from elevenlabs.io/app/voice-library, a model id, and a speed (1 = normal)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_SPEED=

# Polly voice (generative: Danielle Joanna Ruth Salli Matthew Stephen Kenneth Nate Tiffany) and engine (generative|neural)
POLLY_VOICE=Ruth
POLLY_ENGINE=generative

# Optional: custom Transcribe vocabulary name (see README) and an existing S3 bucket for share links
TRANSCRIBE_VOCABULARY=
NOTES_BUCKET=

# Hosting (Railway). Leave all empty locally: the server then stays on 127.0.0.1:8787, localhost only.
# Railway sets PORT and RAILWAY_PUBLIC_DOMAIN itself. Any public domain REQUIRES ACCESS_KEY;
# open the app once as https://<domain>/?key=<ACCESS_KEY> and the browser keeps a cookie for a week.
ACCESS_KEY=
# Extra hostnames to allow, comma-separated (e.g. a custom domain)
ALLOWED_HOSTS=
# HOST=0.0.0.0 to override the bind address
