AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BOARD_MODEL_ID=
# MODEL_PROVIDER=bedrock forces Bedrock for board + notes (default: anthropic if ANTHROPIC_API_KEY is set, else bedrock)
MODEL_PROVIDER=
NOTES_MODEL_ID=us.amazon.nova-micro-v1:0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=
ANTHROPIC_NOTES_MODEL_ID=

# Polly voice (generative: Danielle Joanna Ruth Salli Matthew Stephen Kenneth Nate Tiffany) and engine (generative|neural)
POLLY_VOICE=Ruth
POLLY_ENGINE=generative

# Optional: custom Transcribe vocabulary name (see README) and an existing S3 bucket for share links
TRANSCRIBE_VOCABULARY=
NOTES_BUCKET=
